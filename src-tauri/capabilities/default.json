{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Default permissions for ClawBox",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "openclaw", "cmd": "openclaw", "args": true },
        { "name": "openclaw-gateway", "cmd": "openclaw-gateway", "args": false },
        { "name": "pkill", "cmd": "pkill", "args": true },
        { "name": "lsof", "cmd": "lsof", "args": true }
      ]
    }
  ]
}
